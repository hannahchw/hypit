{
  "format": "hypit.runtime-local@1",
  "dataRoot": ".hypit/runtimes/local",
  "credentials": {
    "env": {
      "use": "@hypit/credential-store-env"
    },
    "local": {
      "use": "@hypit/credential-store-local"
    }
  },
  "endpoints": {
    "hiapi.default": {
      "use": "@hypit/provider-hiapi",
      "pool": "hiapi.default",
      "config": {
        "apiKey": { "store": "env", "key": "HIAPI_API_KEY" },
        "defaultConcurrency": 3,
        "pollIntervalMs": 10000
      }
    },
    "whisperx.local": {
      "use": "@hypit/provider-whisperx-local",
      "config": {
        "expectedModel": "small",
        "expectedDevice": "cpu",
        "expectedCompute": "int8",
        "alignmentLanguages": ["en"]
      }
    },
    "media.local": {
      "use": "@hypit/media-local",
      "config": {
        "defaultConcurrency": 2
      }
    },
    "html.local": {
      "use": "@hypit/provider-html-local",
      "config": {
        "workers": 2,
        "quality": "standard",
        "defaultConcurrency": 1
      }
    }
  },
  "bindings": {}
}
